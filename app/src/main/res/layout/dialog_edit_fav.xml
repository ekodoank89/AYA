<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Lokasi"
        android:textColor="@color/label_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NAMA"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <EditText
        android:id="@+id/e_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coord_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp"
        android:maxLength="40"
        android:inputType="text"
        android:textColor="@color/label_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="LATITUDE"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <EditText
        android:id="@+id/e_lat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coord_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp"
        android:inputType="numberDecimal|numberSigned"
        android:fontFamily="monospace"
        android:textColor="@color/label_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="LONGITUDE"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <EditText
        android:id="@+id/e_lng"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coord_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp"
        android:inputType="numberDecimal|numberSigned"
        android:fontFamily="monospace"
        android:textColor="@color/label_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/e_err"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF8A80"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/e_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_coord_chip"
            android:textColor="@color/label_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Batal" />

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/e_save"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_play_green_touch"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="SIMPAN" />
    </LinearLayout>
</LinearLayout>
