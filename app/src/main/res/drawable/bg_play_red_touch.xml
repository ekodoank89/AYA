<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:right="4dp" android:top="7dp" android:bottom="7dp">
        <shape>
            <corners android:radius="11dp" />
            <gradient android:angle="315"
                android:startColor="@color/play_red_start"
                android:endColor="@color/play_red_end" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="7dp" android:bottom="7dp">
        <shape>
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/play_stroke" />
        </shape>
    </item>
</layer-list>
