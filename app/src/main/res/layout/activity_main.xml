<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/pin_center"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:translationY="-20dp"
        android:contentDescription="Pin lokasi"
        android:elevation="6dp"
        android:src="@drawable/ic_pin" />

    <!-- Chip koordinat pin: GONE sementara -->
    <TextView
        android:id="@+id/tv_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_chip"
        android:elevation="6dp"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="…" />

    <!-- Kolom kanan: GPS + tema -->
    <LinearLayout
        android:id="@+id/sidecol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_my_location"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button"
            android:elevation="6dp"
            android:padding="11dp"
            android:contentDescription="Fokus ke lokasi saya"
            android:src="@drawable/ic_gps" />

        <Space android:layout_width="1dp" android:layout_height="10dp" />

        <ImageButton
            android:id="@+id/btn_theme"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button"
            android:elevation="6dp"
            android:padding="11dp"
            android:contentDescription="Ganti tema peta"
            android:src="@drawable/ic_moon" />

        <Space android:layout_width="1dp" android:layout_height="10dp" />

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:elevation="6dp"
            android:textSize="22sp"
            android:textColor="#212121"
            android:fontFamily="monospace"
            android:text="+" />

        <Space android:layout_width="1dp" android:layout_height="10dp" />

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:elevation="6dp"
            android:textSize="22sp"
            android:textColor="#212121"
            android:fontFamily="monospace"
            android:text="−" />
    </LinearLayout>

    <!-- Panel: GRAB / GOJEK / FAVORIT — satu kontainer -->
    <LinearLayout
        android:id="@+id/playgroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="28dp"
        android:translationX="-8dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="8dp">

        <!-- GRAB -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dot_grab"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_grab"
                    android:textColor="@color/label_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.125" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_grab"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:padding="15dp"
                android:background="@drawable/bg_play_red_touch"
                android:contentDescription="Mulai GRAB"
                android:src="@drawable/ic_play" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_divider" />

        <!-- GOJEK -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dot_gojek"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_gojek"
                    android:textColor="@color/label_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.125" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_gojek"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:padding="15dp"
                android:background="@drawable/bg_play_red_touch"
                android:contentDescription="Mulai GOJEK"
                android:src="@drawable/ic_play" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_divider" />

        <!-- FAVORIT: baris aksi ketiga dalam panel -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:text="@string/favorite_label"
                android:textColor="@color/label_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.125" />

                        <ImageButton
                android:id="@+id/btn_fav"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:padding="13dp"
                android:background="@drawable/bg_fav_touch"
                android:contentDescription="Lokasi tersimpan"
                android:src="@drawable/ic_star_white" />
            
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
