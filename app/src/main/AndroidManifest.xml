<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- Visibilitas manager → target (untuk push broadcast) -->
    <queries>
        <package android:name="com.gojek.partner" />
        <package android:name="com.grabtaxi.driver2" />
        <package android:name="com.gojek.app" />
        <package android:name="com.grabtaxi.passenger" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AYA"
        android:supportsRtl="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- ==== Deklarasi modul Xposed ==== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Substitusi lokasi pin AYA ke aplikasi target" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- Jembatan config manager → hook -->
        <provider
            android:name="com.aya.doank.core.ConfigProvider"
            android:authorities="com.aya.doank.config"
            android:exported="true" />

        <!-- Receiver tombol STOP di notifikasi — ANAK LANGSUNG <application> -->
                <receiver
            android:name="com.aya.doank.ui.NotifController$StopReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
