<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pergerakan Titik (Jitter)"
        android:textColor="@color/label_text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- PEMILIH TARGET -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/seg_grab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="11dp"
            android:background="@drawable/bg_mode_on"
            android:textColor="#C8F7D8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="GRAB" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/seg_gojek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="11dp"
            android:background="@drawable/bg_mode_off"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="GOJEK" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:text="Setiap aplikasi punya setelan dan default-nya sendiri. Perubahan langsung dikirim tanpa restart app target." />

    <!-- RESET KE DEFAULT — teks final di-set dari kode (JitterController), statis hanya placeholder -->
    <Button
        android:id="@+id/btn_reset_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_mode_on"
        android:textColor="#C8F7D8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="Reset ke Default" />

    <!-- Slider langkah -->
    <TextView
        android:id="@+id/lbl_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:text="Langkah per jendela: 2,5 m" />

    <SeekBar
        android:id="@+id/seek_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:min="1"
        android:max="16"
        android:progress="4" />

    <!-- Slider jendela -->
    <TextView
        android:id="@+id/lbl_win"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:text="Jendela (interval): 6 detik" />

    <SeekBar
        android:id="@+id/seek_win"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:min="1"
        android:max="15"
        android:progress="6" />

    <!-- Slider radius -->
    <TextView
        android:id="@+id/lbl_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:text="Radius maksimal: 3 m" />

    <SeekBar
        android:id="@+id/seek_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:min="2"
        android:max="20"
        android:progress="6" />

    <Button
        android:id="@+id/btn_jitter_close"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_play_green_touch"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:text="SELESAI" />
</LinearLayout>
