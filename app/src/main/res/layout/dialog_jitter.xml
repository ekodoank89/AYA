<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pergerakan Titik (Jitter)"
        android:textColor="@color/label_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:text="Titik yang dilihat app target bergerak halus di sekitar pin — meniru GPS asli. Perubahan langsung aktif." />

    <!-- Preset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/preset_diam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_mode_off"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Diam\n1m/10dtk" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/preset_normal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_mode_on"
            android:textColor="#C8F7D8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Normal\n2,5m/6dtk" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/preset_aktif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_mode_off"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Aktif\n5m/3dtk" />
    </LinearLayout>

    <!-- Slider langkah -->
    <TextView
        android:id="@+id/lbl_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:text="Langkah per jendela: 2,5 m" />

    <SeekBar
        android:id="@+id/seek_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="1"
        android:max="16"
        android:progress="4" />

    <!-- Slider jendela -->
    <TextView
        android:id="@+id/lbl_win"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:text="Jendela (interval): 6 detik" />

    <SeekBar
        android:id="@+id/seek_win"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="1"
        android:max="15"
        android:progress="6" />

    <Button
        android:id="@+id/btn_jitter_close"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_play_green_touch"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:text="SELESAI" />
</LinearLayout>
