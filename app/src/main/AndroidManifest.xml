<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Manager harus melihat package target agar broadcast push sampai.
         (Daftar statis; Tahap 3 akan diganti queries intent-launcher agar dinamis.) -->
    <queries>
        <package android:name="com.gojek.partner" />
        <package android:name="com.grabtaxi.driver2" />
        <package android:name="com.gojek.app" />
        <package android:name="com.grabtaxi.passenger" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AYA"
        android:supportsRtl="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Substitusi lokasi pin AYA ke aplikasi target" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        
                <!-- Recommended scope: LSPosed menawarkan ceklis cepat untuk daftar ini -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.aya.doank.config"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
